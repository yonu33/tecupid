{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tecupid",
  "compatibility_date": "2026-11-01",
  // Astro で静的ビルドした dist/ を Workers Static Assets として配信する。
  // MVP ではサーバー側のスクリプト（main）は持たない。
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  // 公開する URL。yonu.work は Cloudflare で管理しているドメインで、
  // ドメインそのもの（yonu.work）は別のサイトなので、サブドメインを使う。
  // デプロイすると、DNS のレコードと証明書は Cloudflare が自動で作る。
  "routes": [
    { "pattern": "tecupid.yonu.work", "custom_domain": true }
  ]
}
