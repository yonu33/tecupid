---
// 利用規約などの文書ページの共通部分
import BaseLayout from "./BaseLayout.astro";
import { lastUpdated } from "../lib/last-updated";

interface Props {
  title: string;
  description?: string;
  /**
   * ページの中身が書かれたファイル（リポジトリのルートからの相対パス）。
   * 最終更新日は、このうち最も新しく変更された日を git の履歴から求める
   */
  sources: string[];
}

const { title, description, sources } = Astro.props;
const updated = lastUpdated(...sources);
---

<BaseLayout title={title} description={description}>
	<main class="doc">
		<p class="doc-back"><a href="/">← tecupid にもどる</a></p>
		<article class="doc-body panel">
			<h1>{title}</h1>
			<slot />
			<p class="doc-updated">最終更新日: <time datetime={updated}>{updated}</time></p>
		</article>
	</main>
</BaseLayout>
