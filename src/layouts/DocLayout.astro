---
// 利用規約などの文書ページの共通部分
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  description?: string;
  /** 最終更新日（YYYY-MM-DD） */
  updated: string;
}

const { title, description, updated } = Astro.props;
---

<BaseLayout title={title} description={description}>
	<main class="doc">
		<p class="doc-back"><a href="/">← tecupid にもどる</a></p>
		<article class="doc-body panel">
			<h1>{title}</h1>
			<slot />
			<p class="doc-updated">最終更新日: <time datetime={updated}>{updated}</time></p>
		</article>
	</main>
</BaseLayout>
