---
// すべてのページの共通部分（head とフッター）
// ドット絵のフォント（SIL OFL 1.1）。外部の CDN を使わず、ビルドに含めて自前で配信する
import "@fontsource/dotgothic16";
import "../styles/global.css";
import SiteFooter from "../components/SiteFooter.astro";
import { BETA } from "../config";
import { OG_HEIGHT, OG_WIDTH, ogImagePath } from "../lib/share";

interface Props {
  title?: string;
  description?: string;
  /** SNS のサムネイルの画像のパス（public からのパス） */
  ogImage?: string;
  /** サムネイルの画像の説明 */
  ogImageAlt?: string;
}

const {
  title,
  description = "エンジニアのための技術マッチングアプリ。特徴カードに答えて、次に学ぶ技術を見つけよう。",
  ogImage = ogImagePath(),
  ogImageAlt = "tecupid: エンジニアのための技術マッチングアプリ",
} = Astro.props;
const pageTitle = title ? `${title} | tecupid` : "tecupid";

// OGP の URL は絶対 URL にする必要がある。本番の URL（astro.config の site）がないときは出力しない
const site = Astro.site;
const pageUrl = site ? new URL(Astro.url.pathname, site).href : undefined;
const ogImageUrl = site ? new URL(ogImage, site).href : undefined;
---

<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="theme-color" content="#0a0f0b" />
		<meta name="description" content={description} />
		{/* ベータ版のあいだは検索エンジンに載せない */}
		{BETA && <meta name="robots" content="noindex" />}
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="tecupid" />
		<meta property="og:locale" content="ja_JP" />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		{pageUrl && <link rel="canonical" href={pageUrl} />}
		{pageUrl && <meta property="og:url" content={pageUrl} />}
		{
			ogImageUrl && (
				<>
					<meta property="og:image" content={ogImageUrl} />
					<meta property="og:image:width" content={String(OG_WIDTH)} />
					<meta property="og:image:height" content={String(OG_HEIGHT)} />
					<meta property="og:image:alt" content={ogImageAlt} />
				</>
			)
		}
		<meta name="twitter:card" content="summary_large_image" />
	</head>
	<body>
		<slot />
		<SiteFooter />
	</body>
</html>
